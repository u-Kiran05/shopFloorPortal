<mvc:View controllerName="shopFloor.controller.View1" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" displayBlock="true">
	<Page showHeader="false" class="shopLoginPage">
		<content>
			<VBox class="loginContainer" alignItems="Center" justifyContent="Center">
				<VBox class="loginCard" alignItems="Center" justifyContent="Center">
					<!-- Login Title -->
					<VBox class="logoBox" alignItems="Center">
						<Title text="Shop Floor Portal" level="H1" class="logoText"/>
					</VBox>
					<!-- Message Strip for Errors -->
					<MessageStrip id="msgStrip" visible="false" type="Error" text="" showIcon="true" showCloseButton="false" class="sapUiTinyMarginBottom"/>
					<!-- User ID Input -->
					<VBox class="loginInputBox">
						<Input id="userIdInput" placeholder="User ID" class="loginInput" width="100%" showValueHelp="false"/>
					</VBox>
					<!-- Password Input -->
					<VBox class="loginInputBox">
						<Input id="passwordInput" placeholder="Password" type="Password" class="loginInput" width="100%"/>
					</VBox>
					<!-- Login Button -->
					<Button text="Log On" press="onLoginPress" class="loginButton"/>
				</VBox>
			</VBox>
		</content>
	</Page>
</mvc:View>