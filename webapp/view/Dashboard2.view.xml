<mvc:View controllerName="shopFloor.controller.Dashboard2" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:layout="sap.ui.layout"
	xmlns:viz="sap.viz.ui5.controls" xmlns:suite="sap.suite.ui.commons" xmlns:core="sap.ui.core">
	<Page>
		<customHeader>
			<Bar>
				<contentLeft>
					<Button icon="sap-icon://nav-back" text="Back" press="onBack"/>
				</contentLeft>
				<contentMiddle>
					<Title text="Production Orders"/>
				</contentMiddle>
				<contentRight>
					<Button icon="sap-icon://log" text="Logout" press="onLogoutPress"/>
				</contentRight>
			</Bar>
		</customHeader>
		<content>
			<!-- Filters -->
			<HBox class="sapUiSmallMargin" alignItems="Center" justifyContent="SpaceBetween">
				<Select id="plantSelect" width="200px" change="onFilterChange">
					<core:ListItem key="0001" text="Werk 0001" icon="sap-icon://factory"/>
					<core:ListItem key="0003" text="Plant 0003 (is-ht-sw)" icon="sap-icon://building"/>
					<core:ListItem key="1009" text="Kaar" icon="sap-icon://home"/>
					<core:ListItem key="2206" text="Amul" icon="sap-icon://nutrition-activity"/>
					<core:ListItem key="Z001" text="Werk 0001" icon="sap-icon://factory"/>
				</Select>
				<Select id="yearPicker" width="120px">
					<core:Item key="2023" text="2023"/>
					<core:Item key="2024" text="2024"/>
					<core:Item key="2025" text="2025"/>
				</Select>
				<Select id="monthPicker" width="150px">
					<core:Item key="" text="All Months"/>
					<core:Item key="01" text="January"/>
					<core:Item key="02" text="February"/>
					<core:Item key="03" text="March"/>
					<core:Item key="04" text="April"/>
					<core:Item key="05" text="May"/>
					<core:Item key="06" text="June"/>
					<core:Item key="07" text="July"/>
					<core:Item key="08" text="August"/>
					<core:Item key="09" text="September"/>
					<core:Item key="10" text="October"/>
					<core:Item key="11" text="November"/>
					<core:Item key="12" text="December"/>
				</Select>
				<Button text="Apply Filter" press="onApplyFilter"/>
			</HBox>
			<!-- KPI Cards -->
			<layout:Grid defaultSpan="L3 M6 S12" class="sapUiMediumMarginTop">
				<VBox class="cardPanel" alignItems="Center">
					<core:Icon src="sap-icon://factory" size="2rem" color="#0a6ed1"/>
					<Title text="Total Orders"/>
					<ObjectNumber number="{chart>/total}" unit="Orders"/>
				</VBox>
				<VBox class="cardPanel" alignItems="Center">
					<core:Icon src="sap-icon://lead" size="2rem" color="#2b7c2b"/>
					<Title text="Materials"/>
					<ObjectNumber number="{chart>/uniqueMaterials}" unit="Items"/>
				</VBox>
				<VBox class="cardPanel" alignItems="Center">
					<core:Icon src="sap-icon://tools-opportunity" size="2rem" color="#e9730c"/>
					<Title text="Plants"/>
					<ObjectNumber number="{chart>/plants}" unit="Units"/>
				</VBox>
				<VBox class="cardPanel" alignItems="Center">
					<core:Icon src="sap-icon://company-view" size="2rem" color="#ab218e"/>
					<Title text="Companies"/>
					<ObjectNumber number="{chart>/companies}" unit="Entities"/>
				</VBox>
			</layout:Grid>
			<suite:ChartContainer class="sapUiMediumMarginTop">
				<suite:content>
					<!-- TABLE FIRST -->
					<suite:ChartContainerContent icon="sap-icon://table-view" title="Order Table">
						<suite:content>
							<VBox>
								<Toolbar>
									<Button icon="sap-icon://nav-back" press="onPrevPage"/>
									<Text text="{= 'Page ' + ${chart>/currentPage} + ' of ' + ${chart>/totalPages}}"/>
									<Button icon="sap-icon://navigation-right-arrow" press="onNextPage"/>
								</Toolbar>
								<Table items="{chart>/pagedResults}">
									<columns>
										<Column><Text text="Order No"/></Column>
										<Column><Text text="Type"/></Column>
										<Column><Text text="Plant"/></Column>
										<Column><Text text="Company"/></Column>
										<Column><Text text="Category"/></Column>
										<Column><Text text="Quantity"/></Column>
										<Column><Text text="Start Date"/></Column>
									</columns>
									<items>
										<ColumnListItem>
											<cells>
												<Text text="{chart>Orderno}"/>
												<Text text="{chart>OrderTypeCode}"/>
												<Text text="{chart>PlantName}"/>
												<Text text="{chart>CompanyCode}"/>
												<Text text="{chart>Ordercategory}"/>
												<Text text="{chart>Orderquantity}"/>
												<Text text="{path: 'chart>Startdate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'yyyy-MM-dd' }}"/>
											</cells>
										</ColumnListItem>
									</items>
								</Table>
							</VBox>
						</suite:content>
					</suite:ChartContainerContent>
					<!-- CHARTS BELOW -->
					<suite:ChartContainerContent icon="sap-icon://line-chart" title="Quantity Trend">
						<suite:content><viz:VizFrame id="qtyProdTrendChart" height="550px" width="100%"/></suite:content>
					</suite:ChartContainerContent>
					<suite:ChartContainerContent icon="sap-icon://bar-chart" title="Order Category">
						<suite:content>
							<viz:VizFrame id="categoryChart" height="550px" width="100%"
								vizProperties="{ plotArea: { dataLabel: { visible: true }, margin: { bottom: 0, top: 20, left: 20, right: 20 } }, title: { visible: false }, valueAxis: { title: { visible: false } }, categoryAxis: { title: { visible: false } }, legend: { visible: false } }"/>
						</suite:content>
					</suite:ChartContainerContent>
				</suite:content>
			</suite:ChartContainer>
		</content>
	</Page>
</mvc:View>