<mvc:View controllerName="shopFloor.controller.Dashboard" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:layout="sap.ui.layout"
	xmlns:viz="sap.viz.ui5.controls" xmlns:core="sap.ui.core">
	<Page>
		<customHeader>
			<Bar>
				<contentLeft>
					<Button icon="sap-icon://log" text="Logout" press="onLogoutPress"/>
				</contentLeft>
				<contentMiddle>
					<Title text="Shop Floor Portal - Planned Orders Dashboard"/>
				</contentMiddle>
				<contentRight>
					<Button icon="sap-icon://navigation-right-arrow" text="Next" press="onNextPress"/>
				</contentRight>
			</Bar>
		</customHeader>
		<content>
			<!-- Filter Section -->
			<HBox class="sapUiSmallMargin" alignItems="Center" justifyContent="SpaceBetween">
			<Select id="plantSelect" width="250px" change="onFilterChange">
					<items>
						<core:ListItem key="0001" text="Werk 0001" icon="sap-icon://factory"/>
						<core:ListItem key="0003" text="Plant 0003 (is-ht-sw)" icon="sap-icon://building"/>
						<core:ListItem key="1009" text="Kaar" icon="sap-icon://home"/>
						<core:ListItem key="2206" text="Amul" icon="sap-icon://nutrition-activity"/>
						<core:ListItem key="Z001" text="Werk 0001" icon="sap-icon://factory"/>
					</items>
				</Select>
				<Select id="yearPicker" width="150px" change="onFilterChange">
					<core:Item key="2023" text="2023"/>
					<core:Item key="2024" text="2024"/>
					<core:Item key="2025" text="2025"/>
				</Select>
				<Select id="monthPicker" width="150px" change="onFilterChange">
					<core:Item key="" text="All Months"/>
					<core:Item key="01" text="January"/>
					<core:Item key="02" text="February"/>
					<core:Item key="03" text="March"/>
					<core:Item key="04" text="April"/>
					<core:Item key="05" text="May"/>
					<core:Item key="06" text="June"/>
					<core:Item key="07" text="July"/>
					<core:Item key="08" text="August"/>
					<core:Item key="09" text="September"/>
					<core:Item key="10" text="October"/>
					<core:Item key="11" text="November"/>
					<core:Item key="12" text="December"/>
				</Select>
				<Button text="Apply Filter" press="onApplyFilter"/>
			</HBox>
			<!-- KPI Cards -->
			<layout:Grid defaultSpan="L3 M6 S12" class="sapUiMediumMarginTop">
				<Panel headerText="Total Orders" class="cardStyle">
					<VBox class="sapUiSmallMargin">
						<ObjectNumber id="totalOrders" number="{chart>/totalOrders}" unit="Orders" class="kpiBlue"/>
					</VBox>
				</Panel>
				<Panel headerText="Total Quantity" class="cardStyle">
					<VBox class="sapUiSmallMargin">
						<ObjectNumber id="totalQty" number="{chart>/totalQty}" unit="Qty" class="kpiGreen"/>
					</VBox>
				</Panel>
				<Panel headerText="Materials" class="cardStyle">
					<VBox class="sapUiSmallMargin">
						<ObjectNumber id="uniqueMaterials" number="{chart>/uniqueMaterials}" unit="Items" class="kpiOrange"/>
					</VBox>
				</Panel>
				<Panel headerText="Controllers" class="cardStyle">
					<VBox class="sapUiSmallMargin">
						<ObjectNumber id="uniqueControllers" number="{chart>/uniqueControllers}" unit="Users" class="kpiPurple"/>
					</VBox>
				</Panel>
			</layout:Grid>
			<!-- Chart Panels (3 per row) -->
			<layout:Grid defaultSpan="L4 M6 S12" class="sapUiMediumMarginTop">
				<Panel headerText="Planned Orders by Month" class="chartPanel chartBlue">
					<viz:VizFrame id="ordersByMonthChart" width="100%" height="250px"/>
				</Panel>
				<Panel headerText="Orders by Material " class="chartPanel chartGreen">
					<viz:VizFrame id="materialChart" width="100%" height="250px"/>
				</Panel>
				<Panel headerText="Orders by Controller" class="chartPanel chartOrange">
					<viz:VizFrame id="controllerChart" width="100%" height="250px"/>
				</Panel>
				<Panel headerText="Status Distribution " class="chartPanel chartPurple">
					<viz:VizFrame id="statusChart" width="100%" height="250px"/>
				</Panel>
				<Panel headerText="Quantity Trend by Month" class="chartPanel chartPink">
					<viz:VizFrame id="qtyTrendChart" width="100%" height="250px"/>
				</Panel>
				<Panel headerText="Lead Time Distribution" class="chartPanel chartTeal">
					<viz:VizFrame id="leadTimeChart" width="100%" height="250px"/>
				</Panel>
			</layout:Grid>
			<!-- Table Card -->
			<Panel headerText="Planned Orders Table" class="sapUiMediumMarginTop">
				<Table items="{chart>/results}">
					<columns>
						<Column><Text text="Order No"/></Column>
						<Column><Text text="Material"/></Column>
						<Column><Text text="Quantity"/></Column>
						<Column><Text text="Unit"/></Column>
						<Column><Text text="Plant"/></Column>
						<Column><Text text="Planner Group"/></Column>
						<Column><Text text="Controller"/></Column>
						<Column><Text text="Status"/></Column>
						<Column><Text text="Start Date"/></Column>
						<Column><Text text="End Date"/></Column>
					</columns>
					<items>
						<ColumnListItem>
							<cells>
								<Text text="{chart>Orderno}"/>
								<Text text="{chart>Matdesc}"/>
								<Text text="{chart>Orderquant}"/>
								<Text text="{chart>Unit}"/>
								<Text text="{chart>Plantname}"/>
								<Text text="{chart>Groupname}"/>
								<Text text="{chart>Controllername}"/>
								<Text text="{chart>Statustxt}"/>
								<Text text="{path: 'chart>Startdate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'yyyy-MM-dd' }}"/>
								<Text text="{path: 'chart>Enddate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'yyyy-MM-dd' }}"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</Panel>
		</content>
	</Page>
</mvc:View>