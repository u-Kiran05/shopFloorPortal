<mvc:View controllerName="shopFloor.controller.Dashboard" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
	xmlns:layout="sap.ui.layout" xmlns:viz="sap.viz.ui5.controls" xmlns:chart="sap.viz.ui5.controls.common.feeds"
	xmlns:suite="sap.suite.ui.commons">
	<Page>
		<customHeader>
			<Bar>
				<contentLeft>
					<Button icon="sap-icon://nav-back" text="Back" press="onBack"/>
				</contentLeft>
				<contentMiddle>
					<Title text="Planned Orders Dashboard - Shop Floor"/>
				</contentMiddle>
				<contentRight>
					<Button icon="sap-icon://log" text="Logout" press="onLogoutPress"/>
				</contentRight>
			</Bar>
		</customHeader>
		<content>
			<!-- Filter Bar -->
			<HBox class="sapUiSmallMargin" alignItems="Center" justifyContent="SpaceBetween">
				<Select id="plantSelect" width="200px">
					<items>
						<core:Item key="0001" text="Werk 0001"/>
						<core:Item key="1009" text="Kaar"/>
					</items>
				</Select>
				<Select id="yearPicker" width="150px">
					<items>
						<core:Item key="2023" text="2023"/>
						<core:Item key="2024" text="2024"/>
						<core:Item key="2025" text="2025"/>
					</items>
				</Select>
				<Select id="monthPicker" width="150px">
					<items>
						<core:Item key="" text="All"/>
						<core:Item key="01" text="Jan"/>
						<core:Item key="02" text="Feb"/>
						<core:Item key="03" text="Mar"/>
						<core:Item key="04" text="Apr"/>
						<core:Item key="05" text="May"/>
						<core:Item key="06" text="Jun"/>
						<core:Item key="07" text="Jul"/>
						<core:Item key="08" text="Aug"/>
						<core:Item key="09" text="Sep"/>
						<core:Item key="10" text="Oct"/>
						<core:Item key="11" text="Nov"/>
						<core:Item key="12" text="Dec"/>
					</items>
				</Select>
				<Button text="Apply Filter" press="onApplyFilter"  icon="sap-icon://filter"/>
			</HBox>
			<!-- KPI Cards -->
			<layout:Grid defaultSpan="L3 M3 S12" class="sapUiMediumMarginTop">
				<VBox class="cardPanel" alignItems="Center">
					<core:Icon src="sap-icon://batch-payments" size="2rem"/>
					<Title text="Total Orders"/>
					<ObjectNumber number="{chart>/totalOrders}" unit="Orders"/>
				</VBox>
				<VBox class="cardPanel" alignItems="Center">
					<core:Icon src="sap-icon://shipping-status" size="2rem"/>
					<Title text="Total Quantity"/>
					<ObjectNumber number="{chart>/totalQty}" unit="Qty"/>
				</VBox>
				<VBox class="cardPanel" alignItems="Center">
					<core:Icon src="sap-icon://product" size="2rem"/>
					<Title text="Unique Materials"/>
					<ObjectNumber number="{chart>/uniqueMaterials}" unit="Items"/>
				</VBox>
				<VBox class="cardPanel" alignItems="Center">
					<core:Icon src="sap-icon://group" size="2rem"/>
					<Title text="Controllers"/>
					<ObjectNumber number="{chart>/uniqueControllers}" unit="Users"/>
				</VBox>
			</layout:Grid>
			<!-- Charts Container -->
			<!-- Unified ChartContainer with Table as one tab -->
			<suite:ChartContainer autoAdjustHeight="true" title="Planned Orders" showZoom="true" class="sapUiMediumMarginTop">
				<suite:content>
					<!-- TABLE TAB - moved to top -->
					<suite:ChartContainerContent title="Planned Orders Table" icon="sap-icon://table-view">
						<suite:content>
							<VBox>
								<Toolbar>
									<Button icon="sap-icon://nav-back" press="onPrevPage"/>
									<Text text="{= 'Page ' + ${chart>/currentPage} + ' of ' + ${chart>/totalPages} }"/>
									<Button icon="sap-icon://navigation-right-arrow" press="onNextPage"/>
								</Toolbar>
								<Table items="{chart>/pagedResults}">
									<columns>
										<Column><Text text="Order No"/></Column>
										<Column><Text text="Material"/></Column>
										<Column><Text text="Quantity"/></Column>
										<Column><Text text="Unit"/></Column>
										<Column><Text text="Planner Group"/></Column>
										<Column><Text text="Controller"/></Column>
										<Column><Text text="Status"/></Column>
										<Column><Text text="Start Date"/></Column>
										<Column><Text text="End Date"/></Column>
									</columns>
									<items>
										<ColumnListItem>
											<cells>
												<Text text="{chart>Orderno}"/>
												<Text text="{chart>Matdesc}"/>
												<Text text="{chart>Orderquant}"/>
												<Text text="{chart>Unit}"/>
												<Text text="{chart>Groupname}"/>
												<Text text="{chart>Controllername}"/>
												<Text text="{chart>Statustxt}"/>
												<Text text="{path: 'chart>Startdate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'yyyy-MM-dd' }}"/>
												<Text text="{path: 'chart>Enddate', type: 'sap.ui.model.type.Date', formatOptions: { pattern: 'yyyy-MM-dd' }}"/>
											</cells>
										</ColumnListItem>
									</items>
								</Table>
							</VBox>
						</suite:content>
					</suite:ChartContainerContent>
					<!-- CHART TABS -->
					<suite:ChartContainerContent title="Planned Orders by Month" icon="sap-icon://calendar">
						<suite:content><viz:VizFrame id="ordersByMonthChart" height="400px"/></suite:content>
					</suite:ChartContainerContent>
					<suite:ChartContainerContent title="Orders by Material" icon="sap-icon://product">
						<suite:content><viz:VizFrame id="materialChart" height="400px"/></suite:content>
					</suite:ChartContainerContent>
					<suite:ChartContainerContent title="Orders by Controller" icon="sap-icon://group">
						<suite:content><viz:VizFrame id="controllerChart" height="400px"/></suite:content>
					</suite:ChartContainerContent>
					<suite:ChartContainerContent title="Status Distribution" icon="sap-icon://status-in-process">
						<suite:content><viz:VizFrame id="statusChart" height="400px"/></suite:content>
					</suite:ChartContainerContent>
					<suite:ChartContainerContent title="Quantity Trend" icon="sap-icon://line-chart">
						<suite:content><viz:VizFrame id="qtyTrendChart" height="400px"/></suite:content>
					</suite:ChartContainerContent>
					<suite:ChartContainerContent title="Lead Time Analysis" icon="sap-icon://time-account">
						<suite:content><viz:VizFrame id="leadTimeChart" height="400px"/></suite:content>
					</suite:ChartContainerContent>
				</suite:content>
			</suite:ChartContainer>
		</content>
	</Page>
</mvc:View>